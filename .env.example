# ============================================================
# AegisShield – Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegisshield
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql://aegis_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/aegisshield

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Backend (NestJS) ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# ── ML Microservice (FastAPI) ──────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# ── Weather API (OpenWeather) ─────────────────────────────────
# Leave empty to use mock data
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ── Payment Gateway (Razorpay sandbox) ───────────────────────
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET

# ── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
